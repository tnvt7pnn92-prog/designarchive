# Copy to .env.local (never committed) and fill in. Without these the site works as a static site,
# saving everything in the browser.

# ---- The site (public: these two end up in the browser, and that is fine) ------------------------
# Supabase → Project Settings → API. The anon key is public by design; row level security protects
# the data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Or accounts on Railway (server/): the address Railway gives the service. When set, it is used
# instead of Supabase.
# VITE_API_URL=https://designarchive-production.up.railway.app

# ---- Accounts API on Railway (set in the Railway service's Variables, never here) ---------------
# DATABASE_URL       set by Railway when you add a Postgres database
# ALLOWED_ORIGINS=https://<user>.github.io,http://localhost:5173
# SITE_URL=https://<user>.github.io/<repository>
# RESEND_API_KEY, EMAIL_FROM   optional: password-reset emails

# ---- Local scripts only (never in the browser, never committed) ---------------------------------
# Used by `node scripts/import-guide.mjs --upload` and the integration tests.
# Supabase → Project Settings → API → service_role.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Server functions (set with: npx supabase secrets set NAME=value) ---------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
#
# SITE_ORIGIN=https://<user>.github.io                 CORS: the site's origin
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
