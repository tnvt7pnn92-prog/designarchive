{
  "name": "design-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-home-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-home-data.mjs",
    "build": "vite build",
    "postbuild": "node scripts/spa-fallback.mjs && node scripts/prerender.mjs",
    "lint": "oxlint",
    "check": "oxlint && node scripts/check-i18n.mjs && node scripts/check-data.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:markets": "node scripts/check-markets.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:photos": "node scripts/check-photos-live.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "guide:import": "node scripts/import-guide.mjs",
    "guide:coverage": "node scripts/guide-coverage.mjs",
    "guide:sources": "node scripts/check-guide-sources.mjs",
    "preview": "node scripts/preview-pages.mjs --base=/",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "globe.gl": "^2.46.2",
    "konva": "^10.5.0",
    "maplibre-gl": "^6.11.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/fraunces": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jimp": "^1.6.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0",
    "wawoff2": "^2.0.1"
  }
}
